{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ir-manager.local/schema/habitat-room.schema.json",
  "title": "IR Manager — Habitat room document",
  "description": "Logical room model exported/imported by Habitat Studio. Contains no mesh data: visuals are resolved from `type` via the object catalogue.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "room",
    "objects"
  ],
  "properties": {
    "schema": {
      "const": "ir-manager/habitat-room"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2,
      "description": "1 = room + catalogue objects; 2 adds the project library (enclosures, instances, assemblies). v1 files load unchanged."
    },
    "room": {
      "type": "object",
      "required": [
        "width",
        "depth",
        "height"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "width": {
          "type": "number",
          "minimum": 1.5,
          "maximum": 30,
          "description": "Interior size west→east (m)"
        },
        "depth": {
          "type": "number",
          "minimum": 1.5,
          "maximum": 30,
          "description": "Interior size north→south (m)"
        },
        "height": {
          "type": "number",
          "minimum": 2.1,
          "maximum": 6,
          "description": "Clear ceiling height (m)"
        },
        "wallThickness": {
          "type": "number",
          "minimum": 0.06,
          "maximum": 0.6
        },
        "finishes": {
          "type": "object",
          "properties": {
            "floor": {
              "type": "string"
            },
            "walls": {
              "type": "string"
            },
            "accentWall": {
              "enum": [
                "none",
                "north",
                "east",
                "south",
                "west"
              ]
            }
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "meta": {
      "type": "object"
    },
    "enclosures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EnclosureTemplate"
      }
    },
    "instances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EnclosureInstance"
      }
    },
    "assemblies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Assembly"
      }
    }
  },
  "$defs": {
    "object": {
      "type": "object",
      "required": [
        "id",
        "type",
        "position",
        "size"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable identifier; map this to your database primary key or keep as external id."
        },
        "type": {
          "type": "string",
          "description": "Catalogue type id (see src/objects/catalog.js)",
          "enum": [
            "terrarium_arid",
            "terrarium_tropical",
            "paludarium",
            "rack_glass",
            "rack_tubs",
            "quarantine",
            "incubator",
            "stand_cabinet",
            "workbench",
            "sink_unit",
            "shelving",
            "storage_cabinet",
            "door",
            "window",
            "control_panel",
            "ac_unit",
            "dehumidifier",
            "sensor",
            "outlet",
            "cable_tray",
            "info_board",
            "exit_sign",
            "fire_extinguisher",
            "plant_large",
            "plant_snake",
            "plant_fern",
            "custom_enclosure",
            "assembly"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "position": {
          "type": "object",
          "required": [
            "x",
            "z"
          ],
          "description": "Footprint centre in plan coordinates (m) from the interior north-west corner",
          "properties": {
            "x": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "elevation": {
          "type": "number",
          "minimum": 0,
          "description": "Bottom of the object above the floor (m); window sill height for windows"
        },
        "rotation": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360,
          "description": "Degrees around the vertical axis; 0 = front faces south (+z)"
        },
        "size": {
          "type": "object",
          "required": [
            "w",
            "d",
            "h"
          ],
          "description": "Logical (collision / footprint) box in metres",
          "properties": {
            "w": {
              "type": "number"
            },
            "d": {
              "type": "number"
            },
            "h": {
              "type": "number"
            }
          }
        },
        "mount": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "wall",
                "offset"
              ],
              "properties": {
                "wall": {
                  "enum": [
                    "north",
                    "east",
                    "south",
                    "west"
                  ]
                },
                "offset": {
                  "type": "number",
                  "description": "Distance along the wall from its start to the object centre (m). Wall starts: north=NW corner, east=NE, south=SE, west=SW."
                }
              }
            }
          ]
        },
        "props": {
          "type": "object",
          "properties": {
            "occupied": {
              "type": "boolean"
            },
            "lighting": {
              "type": "boolean"
            },
            "notes": {
              "type": "string"
            },
            "animal": {
              "type": "object",
              "properties": {
                "species": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              }
            }
          }
        },
        "locked": {
          "type": "boolean"
        },
        "ref": {
          "type": "object",
          "description": "Library reference for type custom_enclosure (instanceId) or assembly (assemblyId). The size is derived from the definition.",
          "properties": {
            "assemblyId": {
              "type": "string"
            },
            "instanceId": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "EnclosureTemplate": {
      "type": "object",
      "description": "Reusable construction definition (metres). See DATA_MODEL.md.",
      "required": [
        "id",
        "name",
        "type",
        "dimensions"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "type": {
          "enum": [
            "glass",
            "pvc",
            "wood",
            "rack",
            "mesh",
            "custom"
          ]
        },
        "dimensions": {
          "type": "object",
          "required": [
            "width",
            "height",
            "depth"
          ],
          "properties": {
            "width": {
              "type": "number",
              "minimum": 0.15,
              "maximum": 3
            },
            "height": {
              "type": "number",
              "minimum": 0.08,
              "maximum": 2.5
            },
            "depth": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 1.5
            }
          }
        },
        "construction": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "frame": {
              "type": "object",
              "properties": {
                "style": {
                  "enum": [
                    "profile",
                    "box"
                  ]
                },
                "color": {
                  "enum": [
                    "black",
                    "alu",
                    "white",
                    "wood",
                    "graphite"
                  ]
                },
                "profile": {
                  "type": "number",
                  "minimum": 0.008,
                  "maximum": 0.05
                }
              }
            },
            "panels": {
              "type": "object",
              "properties": {
                "left": {
                  "enum": [
                    "glass",
                    "pvc",
                    "wood",
                    "mesh",
                    "open"
                  ]
                },
                "right": {
                  "enum": [
                    "glass",
                    "pvc",
                    "wood",
                    "mesh",
                    "open"
                  ]
                },
                "rear": {
                  "enum": [
                    "glass",
                    "pvc",
                    "wood",
                    "mesh",
                    "open"
                  ]
                }
              }
            }
          }
        },
        "front": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "sliding",
                "fixed",
                "hinged-single",
                "hinged-double",
                "mesh",
                "tub",
                "open"
              ]
            },
            "lock": {
              "type": "boolean"
            }
          }
        },
        "ventilation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "side"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "side": {
                "enum": [
                  "top",
                  "front-top",
                  "front-bottom",
                  "left",
                  "right",
                  "rear"
                ]
              },
              "coverage": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 1
              }
            }
          }
        },
        "top": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "mesh",
                "glass",
                "solid",
                "open"
              ]
            }
          }
        },
        "bottom": {
          "type": "object",
          "properties": {
            "type": {
              "const": "solid"
            },
            "base": {
              "type": "number",
              "minimum": 0,
              "maximum": 1.2,
              "description": "height of an integrated cabinet base (m)"
            }
          }
        },
        "background": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "none",
                "sandstone",
                "cork",
                "basalt",
                "foam"
              ]
            }
          }
        },
        "interior": {
          "type": "object",
          "properties": {
            "preset": {
              "enum": [
                "none",
                "arid",
                "tropical",
                "paludarium",
                "custom"
              ]
            },
            "substrate": {
              "type": "object"
            },
            "water": {
              "type": "object"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "x",
                  "z"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "cork",
                      "branch",
                      "rock",
                      "hide",
                      "bowl",
                      "bromeliad",
                      "fern",
                      "grass",
                      "succulent",
                      "moss"
                    ]
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "z": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "s": {
                    "type": "number",
                    "minimum": 0.3,
                    "maximum": 3
                  },
                  "r": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "technology": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "stable slot id within the template"
              },
              "kind": {
                "enum": [
                  "led",
                  "uvb",
                  "basking",
                  "heat_panel",
                  "heat_cable",
                  "mist",
                  "fan",
                  "temp_sensor",
                  "humidity_sensor",
                  "probe",
                  "cable_entry"
                ]
              },
              "label": {
                "type": "string"
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "z": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "visualStyle": {
          "type": "object"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "EnclosureInstance": {
      "type": "object",
      "description": "One physical enclosure (own id, animal, devices).",
      "required": [
        "id",
        "templateId",
        "code"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "templateId": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "maxLength": 24
        },
        "props": {
          "type": "object",
          "properties": {
            "occupied": {
              "type": "boolean"
            },
            "lighting": {
              "type": "boolean"
            },
            "animal": {
              "type": "object"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "devices": {
          "type": "object",
          "description": "template slot id → { deviceId (stable, \"<instanceId>:<slot>\"), entity (future IR Manager / Home Assistant binding) }",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "deviceId": {
                "type": "string"
              },
              "entity": {}
            }
          }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "created": {
              "type": "string"
            },
            "externalId": {
              "description": "future IR Manager database id"
            }
          }
        }
      }
    },
    "Assembly": {
      "type": "object",
      "description": "Physical structure built in the Assembly Builder. Members keep their own ids — never merged.",
      "required": [
        "id",
        "name",
        "members"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "position"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "enclosure",
                  "module"
                ]
              },
              "instanceId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "enclosureId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "module": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "cabinet",
                      "shelf",
                      "technical"
                    ]
                  },
                  "w": {
                    "type": "number"
                  },
                  "h": {
                    "type": "number"
                  },
                  "d": {
                    "type": "number"
                  },
                  "doors": {
                    "type": "integer"
                  }
                }
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0
                  },
                  "z": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "x",
                  "y"
                ]
              },
              "rotation": {
                "type": "number"
              }
            }
          }
        },
        "reserved": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "size",
              "position"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "size": {
                "type": "object"
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0
                  },
                  "z": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "x",
                  "y"
                ]
              }
            }
          }
        },
        "frame": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "none",
                "auto",
                "custom"
              ]
            },
            "profile": {
              "type": "number"
            },
            "color": {
              "type": "string"
            },
            "shelves": {
              "type": "boolean"
            },
            "feet": {
              "type": "boolean"
            },
            "topRail": {
              "type": "boolean"
            }
          }
        },
        "alignment": {
          "enum": [
            "front",
            "back"
          ]
        },
        "limit": {
          "type": [
            "object",
            "null"
          ]
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}